{
  "presets": [
    {
      "id": "preset-indie-2d",
      "name": "Indie & 2D (Ultra Battery)",
      "description": "Low-overhead 720p profile with WineD3D/DXVK Lite and conservative Box64 dynarec.",
      "translator": "BOX64",
      "box64Profile": "STABILITY",
      "dxWrapper": "DXVK",
      "resolution": "1280x720",
      "fpsLimit": 60,
      "envVars": {
        "BOX64_DYNAREC_BIGBLOCK": "1",
        "BOX64_DYNAREC_STRONGMEM": "1",
        "DXVK_ASYNC": "1"
      }
    },
    {
      "id": "preset-dx11-3d",
      "name": "3D DX11 Action (Balanced)",
      "description": "Turnip/Vulkan + DXVK 2.5.3 with fast dynarec and shader state cache.",
      "translator": "BOX64",
      "box64Profile": "PERFORMANCE",
      "dxWrapper": "DXVK",
      "resolution": "1280x720",
      "fpsLimit": 60,
      "envVars": {
        "BOX64_DYNAREC_BIGBLOCK": "2",
        "BOX64_DYNAREC_FASTNAN": "1",
        "BOX64_DYNAREC_FASTROUND": "1",
        "DXVK_STATE_CACHE": "1"
      }
    },
    {
      "id": "preset-dx12-heavy",
      "name": "DX12 Heavy (Max Throughput)",
      "description": "Wine ARM64EC + VKD3D-Proton with big-core CPU affinity pinning.",
      "translator": "FEX",
      "box64Profile": "PERFORMANCE",
      "dxWrapper": "VKD3D_PROTON",
      "resolution": "960x540",
      "fpsLimit": 40,
      "envVars": {
        "VKD3D_FEATURE_LEVEL": "12_1",
        "VKD3D_SHADER_CACHE_PATH": "/tmp/vkd3d_cache"
      }
    }
  ]
}
